# Release imzalama sirlari - ORNEK DOSYA
#
# Bu dosyayi `keystore.properties` olarak kopyalayin ve doldurun.
# `keystore.properties` .gitignore'da; asla commit etmeyin.
#
#   cp keystore.properties.example keystore.properties
#
# Anahtar deposu yoksa once uretin (bir kez, ve YEDEKLEYIN - kaybederseniz
# ayni uygulamayi bir daha guncelleyemezsiniz):
#
#   keytool -genkeypair -v -keystore release-key.jks \
#     -alias bildirimbutce -keyalg RSA -keysize 2048 -validity 10000
#
# CI'da dosya yerine ortam degiskenlerini kullanin; onlar oncelikli:
#   BB_KEYSTORE_FILE, BB_KEYSTORE_PASSWORD, BB_KEY_ALIAS, BB_KEY_PASSWORD

# Depo yolu - repo kokune gore cozulur, mutlak yol da kabul edilir.
# Depoyu repo icine koymayin, disarida tutun.
storeFile=../release-key.jks
storePassword=
keyAlias=bildirimbutce
keyPassword=
