{
  "version": 1,
  "updatedAt": "2026-08-21",
  "comment": "Bu dosya uygulamadan bagimsiz guncellenebilir. Uygulama acilista assets/patterns.json ile calisir, sonra remoteUrl'den daha yuksek 'version' varsa onu indirip cache'ler.",
  "macros": {
    "amount": "(?<amount>\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2}|\\d{1,3}(?:\\.\\d{3})+|\\d+)",
    "cur": "(?<currency>TL|TRY|TRL|USD|EUR|GBP|₺|\\$)",
    "merchant": "(?<merchant>[\\p{L}0-9&*.'\\-/ ]{2,60}?)"
  },
  "sources": [
    "com.google.android.apps.messaging",
    "com.samsung.android.messaging",
    "com.android.mms",
    "com.garanti.cepsubesi",
    "com.pozitron.iscep",
    "com.akbank.android.apps.akbank_direkt",
    "com.ykb.android",
    "com.tmobtech.halkbank",
    "com.ziraat.ziraatmobil",
    "com.vakifbank.mobile",
    "com.finansbank.mobile.cepsube",
    "com.denizbank.mobildeniz",
    "com.teb.cepsube",
    "com.magiclick.odeabank",
    "finansbank.enpara",
    "com.papara.mobile",
    "tr.com.ininal.mobile"
  ],
  "ignore": [
    "(?iu)(tek kullanımlık|dogrulama kodu|doğrulama kodu|onay kodu|şifreniz|sifreniz|otp)",
    "(?iu)(kullanılabilir bakiye|hesap bakiye|\\bbakiye(?:niz|si)\\b)",
    "(?iu)(iptal edilmiştir|iptal edilmistir|provizyon iptal|başarısız|basarisiz|reddedil)",
    "(?iu)(kampanya|fırsat|firsat|indirim kodu|hediye|puan kazand|chip para)",
    "(?iu)(borcunuz|son ödeme tarihi|ekstre|asgari tutar)",
    "(?iu)(talimat|otomatik ödeme talimat|limit artır)",
    "(?iu)(limitiniz|limit güncelle|kart limiti)"
  ],
  "patterns": [
    {
      "id": "refund",
      "kind": "REFUND",
      "priority": 5,
      "regex": "(?iu){merchant}\\s*(?:işyerinden|isyerinden|mağazasından|magazasindan|firmasından|['’]?(?:den|dan|ten|tan))\\s*{amount}\\s*{cur}\\s*(?:tutarında)?\\s*(?:iade|geri ödeme)"
    },
    {
      "id": "merchant_then_amount",
      "kind": "EXPENSE",
      "priority": 10,
      "regex": "(?iu){merchant}\\s*(?:adlı\\s+)?(?:üye\\s+)?(?:işyerinde|isyerinde|mağazasında|magazasinda|firmasında|bünyesinde|['’]?(?:de|da|te|ta|den|dan|ten|tan|nde|nda|ndan|nden))\\s*,?\\s*{amount}\\s*{cur}\\s*(?:tutarında|tutarinda)?\\s*(?:tutarlı)?(?:\\s+\\p{L}+){0,2}?\\s*(?:harcama|işlem|islem|ödeme|odeme|alışveriş)"
    },
    {
      "id": "amount_then_merchant",
      "kind": "EXPENSE",
      "priority": 20,
      "regex": "(?iu){amount}\\s*{cur}\\s*(?:tutarında)?\\s*(?:harcamanız|harcama|işlem|ödeme)\\s*(?:.{0,20}?)\\s*{merchant}\\s*(?:bünyesinde|firmasında|işyerinde|isyerinde|mağazasında|['’](?:de|da|te|ta)\\b)"
    },
    {
      "id": "card_merchant_amount",
      "kind": "EXPENSE",
      "priority": 30,
      "regex": "(?iu)kartınız(?:la|\\s+ile|dan|\\s+ile\\s+)\\s*{merchant}\\s+{amount}\\s*{cur}"
    },
    {
      "id": "fallback_amount_only",
      "kind": "EXPENSE",
      "priority": 90,
      "regex": "(?iu){amount}\\s*{cur}\\s*(?:tutarında)?\\s*(?:harcama|ödeme yap|işlem gerçekle)"
    }
  ],
  "brandTokens": [
    "BIM",
    "IKEA",
    "LC",
