<?xml version="1.0" encoding="utf-8"?>
<!--
  Harcama verisi bilerek yedeklenmez: bildirim metinleri hassastir ve
  cihazi terk etmemelidir. "Verileriniz telefonda kalir" iddiasinin
  teknik karsiligi burasidir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
