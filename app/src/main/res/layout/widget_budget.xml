<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 widget. RemoteViews Compose token'larina erisemez; renkler
     values/colors.xml + values-night/colors.xml icinde Theme.kt ile
     senkron tutulur (bkz. o dosyalardaki yorumlar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jetbrains_mono_medium"
        android:textSize="9sp"
        android:letterSpacing="0.18"
        android:textColor="@color/widget_ink_muted"
        android:text="@string/widget_description" />

    <!-- Yer tutucuda ₺ yok, bilerek. Simge calisma aninda sistem fontu span'iyla
         yaziliyor (bkz. ui/theme/Lira.kt): Schibsted Grotesk 1.100 U+20BA'yi
         yanlis ciziyor. `android:text` font span'i tasiyamadigi icin burada
         yazilamaz; widget secicisindeki onizleme bu yuzden simgesiz. Simgeyi
         ayri bir TextView'a almak denendi ve geri alindi: 2x1 hucrede tutar tum
         genisligi kapiyor, son cocuk olan simge kirpiliyordu. -->
    <!-- Tasarim: 700 31px/.95 -.05em. AGIRLIK ve TRACKING alindi, BOYUT
         alinmadi - 28sp'de kaldi. Gerekcesi roadmap 15. maddede duran acik
         hata: bu widget 2 sutunluk dar hucrede tutar uzunken zaten kirpiyor;
         31sp'ye cikarmak o hatayi buyuturdu. Tracking'in -.05'e sikilmasi
         Bold'un getirdigi fazladan genisligin bir kismini geri aliyor. -->
    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/schibsted_grotesk_bold"
        android:textSize="28sp"
        android:letterSpacing="-0.05"
        android:textColor="@color/widget_ink"
        android:text="0,00" />

    <ImageView
        android:id="@+id/widget_ribbon"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="10dp"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

</LinearLayout>
