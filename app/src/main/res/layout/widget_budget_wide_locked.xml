<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 widget'in ucretsiz surumdeki hali.

     Bos bir kart degil: kullanici widget'i ana ekranina koydu, karsiliginda ne
     oldugunu ogrenmeli. Dokunus paywall'a gidiyor (WideBudgetWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wide_locked_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jetbrains_mono_medium"
        android:textSize="9sp"
        android:letterSpacing="0.18"
        android:maxLines="1"
        android:textColor="@color/widget_pro"
        android:text="@string/widget_wide_locked_kicker" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/schibsted_grotesk_semibold"
        android:textSize="16sp"
        android:letterSpacing="-0.02"
        android:maxLines="2"
        android:textColor="@color/widget_ink"
        android:text="@string/widget_wide_locked_title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/schibsted_grotesk_regular"
        android:textSize="12sp"
        android:maxLines="2"
        android:textColor="@color/widget_ink_muted"
        android:text="@string/widget_wide_locked_body" />

</LinearLayout>
